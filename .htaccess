# Záložné nastavenie: ak bol celý projekt nahratý do koreňa webu,
# všetky požiadavky sa presmerujú do priečinka public/ a app/ je neprístupný.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|docs|tests|\.git|\.github)(/|$) - [F,L]
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
