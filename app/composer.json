{
    "name": "diet-manager/app",
    "description": "Diet Manager – sledovanie stravy",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "anthropic-ai/sdk": "^1.12",
        "guzzlehttp/guzzle": "^7.9"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "config": {
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": { "php": "8.1.0" },
        "allow-plugins": { "php-http/discovery": false }
    }
}
